# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional override. Must include the "anthropic/" provider prefix for LiteLLM routing.
# Defaults to anthropic/claude-sonnet-5 if unset.
CLAUDE_MODEL=anthropic/claude-sonnet-5

# Optional: per-document audit-outcome Slack notifications. Leave both blank to disable.
# SLACK_BOT_TOKEN: a Slack bot token (starts with "xoxb-") with the chat:write scope.
# SLACK_CHANNEL: the channel ID (e.g. C0123456789) or name (e.g. #gl-recon-alerts) to post
# to. The bot must be invited to this channel first ("/invite @YourBotName" in Slack) or
# posting fails with a "not_in_channel" error.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Optional: real email sending for Document Chaser's "Approve & Send". Leave blank to
# disable (the draft still shows in the UI, it just won't send). Generic SMTP — the demo
# uses Google Workspace, production would point this at the client's own mail server
# instead, with no code change.
# SMTP_HOST/SMTP_PORT default to Google's smtp.gmail.com:587 if unset.
# SMTP_USERNAME/SMTP_PASSWORD: a mailbox + an App Password (Google Account -> Security ->
# 2-Step Verification -> App Passwords), not your normal account password.
# SMTP_FROM_EMAIL: the "From" address (usually the same as SMTP_USERNAME).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Temporary demo safety valve: every Document Chaser send goes here instead of a real
# client, since the demo roster (chaser_data.py) has no real client email addresses yet.
CHASER_EMAIL_OVERRIDE=ramya.rajaram@mystiqlabs.ai

# Where this app can be reached from a browser — used to build the "Edit"/"Approve & Send"
# link buttons on a Document Chaser Slack post. Defaults to local dev; change this if the
# app is ever deployed somewhere with a real URL.
APP_BASE_URL=http://localhost:8501
